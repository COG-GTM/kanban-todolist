# Copy to .env and fill in real values to enable the "Run with Devin" integration.
# The app works without these — the Devin UI simply stays hidden.
# Never commit the real .env.

# Devin API key (server-side only, never sent to the browser)
DEVIN_API_KEY=cog_your_api_key_here

# Devin organization the sessions are created in
DEVIN_ORG_ID=org-your_org_id_here

# Email of the Devin user the sessions are created as
DEVIN_USER_EMAIL=you@yourcompany.com

# Port for the local server
PORT=3000
